    "strict": true,
    "jsx": "react-native",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx", "App.tsx", "index.ts", "config.js"],
  "exclude": ["design/v0-reference", "design/transport-company-app-ref"]
}
