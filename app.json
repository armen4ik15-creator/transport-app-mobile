{
  "expo": {
    "name": "ReestrPro",
    "slug": "reestrpro-mobile",
    "version": "1.5.9",
    "orientation": "portrait",
    "scheme": "reestrpro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "runtimeVersion": "1.3.8",
    "updates": {
      "url": "https://u.expo.dev/55c1448c-d923-4b4a-9214-ba474b5a951e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "cli": {
      "appVersionSource": "local"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Доступ к камере нужен для фото ТТН по заказу.",
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен для прикрепления ТТН."
      }
    },
    "android": {
      "package": "com.reestrpro.mobile",
      "versionCode": 39,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.reestrpro.mobile.** { *; }\n-keep class expo.modules.** { *; }"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Разрешите доступ к камере для фото ТТН.",
          "photosPermission": "Разрешите доступ к фотогалерее для прикрепления ТТН."
        }
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "55c1448c-d923-4b4a-9214-ba474b5a951e"
      }
    }
  }
}
