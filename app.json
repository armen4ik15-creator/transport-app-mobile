{
  "expo": {
    "name": "ReestrPro Экспериментальный",
    "slug": "reestrpro-experimental",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "reestrpro-experimental",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "cli": {
      "appVersionSource": "local"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reestrpro.experimental",
      "infoPlist": {
        "NSCameraUsageDescription": "Доступ к камере нужен для фото ТТН по заказу.",
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен для прикрепления ТТН."
      }
    },
    "android": {
      "package": "com.reestrpro.experimental",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Разрешите доступ к камере для фото ТТН.",
          "photosPermission": "Разрешите доступ к фотогалерее для прикрепления ТТН."
        }
      ]
    ],
    "extra": {
      "isExperimentalBuild": true
    }
  }
}
